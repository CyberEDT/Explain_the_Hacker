{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContentOpportunity",
  "type": "object",
  "required": [
    "opportunity_id",
    "topic",
    "target_keywords",
    "recommended_content_type",
    "priority",
    "uncertainty"
  ],
  "properties": {
    "recommended_content_type": {
      "enum": [
        "product_landing_page",
        "free_tool",
        "role_specific_guide",
        "comparison_page",
        "certification_directory",
        "career_roadmap",
        "tutorial",
        "FAQ",
        "interview_preparation",
        "portfolio_project_guide"
      ]
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "research_required"
      ]
    },
    "target_keywords": {
      "type": "array",
      "minItems": 1
    }
  }
}