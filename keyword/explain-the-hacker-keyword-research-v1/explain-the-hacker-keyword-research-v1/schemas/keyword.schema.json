{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KeywordRecord",
  "type": "object",
  "required": [
    "keyword_id",
    "keyword",
    "normalized_keyword",
    "market",
    "intent",
    "classification",
    "metrics",
    "serp",
    "opportunity",
    "provenance",
    "notes"
  ],
  "properties": {
    "keyword_id": {
      "pattern": "^kw_(in|intl)_[0-9]{6}$"
    },
    "market": {
      "type": "object",
      "properties": {
        "country": {
          "enum": [
            "India",
            "International_unspecified"
          ]
        },
        "language": {
          "const": "en"
        }
      }
    },
    "intent": {
      "type": "object",
      "properties": {
        "primary": {
          "enum": [
            "informational",
            "navigational",
            "commercial_investigation",
            "transactional",
            "job_seeking",
            "educational",
            "mixed",
            "unclear"
          ]
        },
        "secondary": {
          "type": "array",
          "items": {
            "enum": [
              "informational",
              "navigational",
              "commercial_investigation",
              "transactional",
              "job_seeking",
              "educational",
              "mixed",
              "unclear"
            ]
          }
        }
      }
    },
    "classification": {
      "type": "object",
      "properties": {
        "topic_cluster": {
          "enum": [
            "eth_attack_chain",
            "eth_mitre_mapping",
            "eth_hacker_mindset",
            "eth_soc_training",
            "eth_red_team_learning",
            "eth_ioc_analysis",
            "eth_campaign_walkthroughs",
            "eth_brand"
          ]
        },
        "funnel_stage": {
          "enum": [
            "awareness",
            "consideration",
            "decision"
          ]
        },
        "keyword_type": {
          "enum": [
            "head",
            "mid_tail",
            "long_tail"
          ]
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "monthly_search_volume": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "keyword_difficulty": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "serp": {
      "type": "object",
      "properties": {
        "ranking_urls": {
          "type": "array",
          "maxItems": 0
        },
        "observed_pages_in_search_results": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https?://"
          }
        }
      }
    },
    "opportunity": {
      "type": "object",
      "properties": {
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "research_required"
          ]
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "demand_evidence": {
          "enum": [
            "unverified",
            "qualitative_signal",
            "quantitative"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "pattern": "^H[0-9]{2}$"
          }
        }
      }
    }
  }
}