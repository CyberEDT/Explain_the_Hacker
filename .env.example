# ──────────────────────────────────────────────────────
# Explain The Hacker — Environment Variables Reference
# ──────────────────────────────────────────────────────
# Copy this file to .env for local development.
# Never commit .env or .env.production to version control.
# ──────────────────────────────────────────────────────

# ── Mock Mode ─────────────────────────────────────────
# Set to 'true' to use the built-in mock response (no backend needed).
# Set to 'false' to use the real CyberEDT API.
VITE_USE_MOCK=true

# ── Backend API ───────────────────────────────────────
# Base URL for the real CyberEDT API.
# Only used when VITE_USE_MOCK=false.
VITE_API_BASE_URL=https://api.cyberedt.io/v1
